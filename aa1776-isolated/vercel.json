{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 16 24-26 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "*/15 19-20 24 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "0,15 21 24 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 19 25 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 20 25 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "15,30,45 21 25 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "*/15 22-23 25 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "30,45 18 26 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "*/15 19-20 26 11 *"
    },
    {
      "path": "/api/cron",
      "schedule": "0,15 21 26 11 *"
    },
    {
      "path": "/api/purge",
      "schedule": "15 0 24-27 11 *"
    },
    {
      "path": "/api/purge",
      "schedule": "0 11 27 11 *"
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/purge.js": {
      "maxDuration": 30
    }
  }
}
